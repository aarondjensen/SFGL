# SFGL environment variables
#
# Copy to `.env.local` for local development. Never commit the filled-in copy —
# .gitignore already covers .env*.local.
#
# Two audiences, and the distinction matters:
#
#   VITE_*  are read by the browser bundle. Vite inlines them at build time, so
#           they are PUBLIC. Firebase's web config is designed for this — it
#           identifies the project, it does not authorize anything. What keeps
#           the data safe is Firestore security rules (see firestore.rules) and
#           App Check, never the secrecy of these values.
#
#   the rest are read by the serverless functions in api/ at runtime on Vercel.
#   These ARE secrets. Set them in Vercel → Settings → Environment Variables;
#   nothing here should ever reach the browser.

# ── Browser: Firebase web config ─────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Browser: App Check ───────────────────────────────────────────────────────
# reCAPTCHA v3 site key. Firebase console → App Check → Apps → Web.
# Unset means App Check is not initialized; the app still runs.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ── Browser: Web Push ────────────────────────────────────────────────────────
# The VAPID public key. Firebase console → Project settings → Cloud Messaging →
# Web Push certificates. Without it, subscription attempts fail with a clear
# error instead of silently registering bad tokens (see api/pushNotifications).
VITE_FIREBASE_VAPID_KEY=

# ── Server: Firebase Admin ───────────────────────────────────────────────────
# The service-account JSON, as a single-line string. Firebase console → Project
# settings → Service accounts → Generate new private key. Admin credentials
# BYPASS Firestore rules entirely — this is the most sensitive value here.
FIREBASE_SERVICE_ACCOUNT=

# ── Server: cron authentication ──────────────────────────────────────────────
# Shared secret for scheduler-invoked actions on /api/cron (waivers,
# process-results, owgr-rankings, lineup-reminder, lead-watch, field-check).
# Sent as `Authorization: Bearer <CRON_SECRET>`. Protected actions FAIL CLOSED
# when this is unset — the endpoint returns 503 rather than running unauthed.
# It is also accepted in place of a commissioner ID token, so treat it as
# equivalent to full commissioner access.
CRON_SECRET=

# ── Server: cron-job.org management ──────────────────────────────────────────
# API key for the `sync-cron-schedule` action, which reconciles the schedules
# held at cron-job.org with the league's tournament calendar. Only that one
# action needs it.
CRONJOB_API_KEY=

# ── Server: outbound email (Brevo) ───────────────────────────────────────────
# Used for manager notifications and for the error reports below. When
# BREVO_API_KEY is unset, email is skipped with a warning rather than failing
# the request that triggered it.
BREVO_API_KEY=
EMAIL_FROM="SFGL <league@example.com>"

# ── Server: client error reports ─────────────────────────────────────────────
# /api/log-error emails sanitized crash reports from the ErrorBoundary here.
ERROR_REPORT_TO=
ERROR_REPORT_FROM=
