rules_version = '2';

// ============================================================================
// SFGL Firestore security rules
//
// DEPLOYED. This file is the source of truth for what is live; keep the two in
// step. There is no firebase.json here, so publishing is a manual paste into
// Firebase console → Firestore → Rules. Edit here first, then paste.
//
// What this replaced, and why it mattered:
//
//     match /{document=**} { allow read, write: if request.auth != null; }
//
// Any signed-in account could read and write every document. Sign-in is open
// Google/Apple with no allowlist, so that included anybody who found the site
// and signed in with a throwaway account. The app's ownership checks and its
// commish toggle are client-side JavaScript — advisory to anyone willing to
// skip the UI and call Firestore directly.
//
// Before changing anything here, use the Rules Playground on the draft. The
// checks that matter, simulated as a plain manager (Authenticated, a real uid,
// NO custom claims):
//
//   update  teams/{their team}          field abbr    -> allow
//   update  teams/{someone else's}      field abbr    -> deny
//   update  sfgl_data/player-registry   any field     -> allow
//
// The first and third are the paths every manager hits on every roster save;
// the second is what proves the rules are doing anything at all.
//
// An earlier draft of this file was written by reading the app's UI and
// inferring the access pattern. It was wrong in six ways, each of which would
// have broken the app for ordinary managers:
//
//   1. Ownership was keyed on teams/{id}.uid. It is not there — it lives in
//      team_claims/{teamId}.uid, a collection the earlier draft never
//      mentioned at all, so every manager write was denied and nobody could
//      claim a team.
//   2. sfgl_data was commissioner-only. registryUpkeep in useLeague writes
//      sfgl_data/player-registry on EVERY roster and lineup save, by any
//      manager.
//   3. Transactions were required to be created with status 'pending'. That is
//      true of a waiver claim; a free-agent add is written 'processed'.
//   4. /players was commissioner-only. App.jsx's headshot flow writes espn_id
//      and pga_id there for any signed-in user.
//   5. app_metadata was commissioner-only. The same headshot flow stamps
//      players_last_updated.
//   6. It carried rules for tournament_results, a collection since retired —
//      it had no writer and, per scripts/audit-tournament-results.mjs, no
//      documents.
//
// The version below is derived from the actual write paths in src/. Every
// "a manager may" clause names the code that needs it. A rule here without
// such a note is an assumption that has not been checked.
//
// ── The model ───────────────────────────────────────────────────────────────
//
// Identity is Firebase Auth. Commissioner authority is a CUSTOM CLAIM
// (token.commissioner === true), stamped server-side by api/cron.js via
// setCustomUserClaims — never a client-writable field.
//
// Team ownership is team_claims/{teamId}.uid == the signed-in uid. A manager
// self-claims an UNCLAIMED team; reassigning a claimed one is a commissioner
// action (see claimTeam / reassignTeam in src/api/authApi.js).
//
// api/cron.js and api/push.js use firebase-admin, which bypasses rules
// entirely — nothing here constrains the server.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // .get() rather than a bare property read. A token WITHOUT the claim has no
    // `commissioner` key, and a missing key on a Map raises rather than
    // returning false — so `request.auth.token.commissioner == true` errors for
    // every ordinary manager. Firestore recovers when the other side of an ||
    // is true, which is why it appeared to work, but that leaves the primary
    // authorization check depending on error-recovery semantics and logs a
    // warning on every manager evaluation. The Rules Playground reports it as
    // "Property commissioner is undefined on object".
    function isCommish() {
      return signedIn() && request.auth.token.get('commissioner', false) == true;
    }

    // Ownership lives in team_claims, NOT on the team document.
    function ownsTeam(teamId) {
      return signedIn()
        && teamId != null
        && exists(/databases/$(database)/documents/team_claims/$(teamId))
        && get(/databases/$(database)/documents/team_claims/$(teamId)).data.get('uid', null) == request.auth.uid;
    }

    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ── Team claims — the ownership record ──────────────────────────────────
    // Read is open to any member: App.jsx subscribes to the whole collection
    // and scans it to find which team the signed-in uid owns (teamIdForUid).
    //
    // A manager may claim a team nobody owns, and may only set it to THEIR OWN
    // uid — claiming on someone else's behalf, or taking over a claimed team,
    // is a commissioner action. That mirrors claimTeam(), which refuses when a
    // different uid already holds the team, and puts the same rule
    // server-side where calling Firestore directly cannot bypass it.
    match /team_claims/{teamId} {
      allow read: if signedIn();
      allow create: if isCommish()
                    || (signedIn() && request.resource.data.get('uid', null) == request.auth.uid);
      allow update: if isCommish()
                    || (signedIn()
                        && request.resource.data.get('uid', null) == request.auth.uid
                        // Unclaimed, or already mine — never a takeover.
                        && (resource.data.get('uid', null) == null
                            || resource.data.get('uid', null) == request.auth.uid))
                    // The owner may also set their own notify email
                    // (setNotifyEmail in authApi) without touching uid.
                    || (ownsTeam(teamId) && onlyChanges(['notifyEmail', 'email', 'displayName']));
      allow delete: if isCommish();
    }

    // ── Teams ───────────────────────────────────────────────────────────────
    // Any member sees every roster — that is the app. Writes are the
    // commissioner, or the owning manager on a bounded set of fields.
    //
    // `abbr` is here because a manager sets their own short name from the
    // Account sheet. `uid` is NOT here, and is not what ownership reads
    // anyway — see team_claims above.
    //
    // updateTeams writes whole documents via set() without merge, so unchanged
    // fields are still sent; affectedKeys() reports only keys whose VALUE
    // changed, so that is fine. A write that DROPS a field the document had
    // shows up as an affected key and is denied, which is what we want.
    function managerEditableTeamFields() {
      return ['name', 'abbr', 'roster', 'lineup', 'backup', 'notificationPrefs',
              'email', 'displayName', 'allowance', 'registryOverrides',
              'earnings', 'segmentEarnings', 'segmentFees', 'transactionFees',
              'mulligans'];
    }

    match /teams/{teamId} {
      allow read:   if signedIn();
      allow create, delete: if isCommish();
      allow update: if isCommish()
                    || (ownsTeam(teamId) && onlyChanges(managerEditableTeamFields()));
    }

    // ── Transactions ────────────────────────────────────────────────────────
    // Ownership keys on `teamId` and nothing else. `team` holds the display
    // NAME, which managers can edit — keying on it is what a rename used to
    // break. scripts/backfill-transaction-teamid.mjs has been run against
    // production: all 60 rows carry a teamId, so there is no name fallback.
    //
    // The two types a manager creates carry DIFFERENT statuses, which the
    // earlier draft got wrong (see AddDropPlayerModal):
    //
    //   waiver       'pending'    — the cron or the commissioner decides it
    //   free agent   'processed'  — immediate, no adjudication
    //
    // Requiring 'pending' for a waiver is what stops a manager self-approving
    // their own claim with a single field write. Requiring 'processed' for a
    // free agent stops the reverse — smuggling a claim in as an FA add.
    // Mulligan and swing_winner rows are commissioner-only.
    match /transactions/{txId} {
      allow read: if signedIn();

      allow create: if isCommish()
                    || (signedIn()
                        && ownsTeam(request.resource.data.get('teamId', null))
                        && (
                          (request.resource.data.get('type', '') == 'waiver'
                            && request.resource.data.get('status', '') == 'pending')
                          || (request.resource.data.get('type', '') == 'free agent'
                            && request.resource.data.get('status', '') == 'processed')
                        ));

      // Editing or withdrawing your own claim while it is still pending, and
      // without moving it out of pending or handing it to another team.
      // A processed row is history; only the commissioner touches it.
      allow update: if isCommish()
                    || (ownsTeam(resource.data.get('teamId', null))
                        && resource.data.get('status', '') == 'pending'
                        && request.resource.data.get('status', '') == 'pending'
                        && request.resource.data.get('teamId', null) == resource.data.get('teamId', null));

      allow delete: if isCommish()
                    || (ownsTeam(resource.data.get('teamId', null))
                        && resource.data.get('status', '') == 'pending');
    }

    // ── Players ─────────────────────────────────────────────────────────────
    // Commissioner-owned in spirit: world ranks, LIV status and career stats
    // all come from the OWGR/PGAT syncs.
    //
    // But App.jsx resolves missing headshots for ANY signed-in user and writes
    // the ids back (playersApi.upsertMany with {name, espnId, pgaId}), so a
    // manager needs a narrow write here. Restricted to those id fields: a
    // manager cannot alter a world rank, a LIV flag or career earnings.
    function headshotIdFields() {
      return ['name', 'espn_id', 'pga_id'];
    }

    match /players/{name} {
      allow read: if signedIn();
      allow create: if isCommish()
                    || (signedIn() && request.resource.data.keys().hasOnly(headshotIdFields()));
      allow update: if isCommish()
                    || (signedIn() && onlyChanges(headshotIdFields()));
      allow delete: if isCommish();
    }

    // ── app_metadata ────────────────────────────────────────────────────────
    // Sync timestamps. playersApi.upsertMany stamps players_last_updated, and
    // that runs on the manager headshot path above, so this cannot be
    // commissioner-only without breaking it.
    match /app_metadata/{key} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ── sfgl_data ───────────────────────────────────────────────────────────
    // Mostly disaster-recovery backups of whole collections — commissioner.
    //
    // The exception is `player-registry`, the durable player-attribute index.
    // registryUpkeep in useLeague rewrites it at the team-save chokepoint, so
    // every roster edit and every lineup change by any manager writes here.
    // The earlier draft made this commissioner-only, which would have failed
    // every manager save in the league.
    match /sfgl_data/{key} {
      allow read: if signedIn();
      allow write: if isCommish() || (signedIn() && key == 'player-registry');
    }

    // ── Commissioner-owned league data ──────────────────────────────────────
    // The schedule and the league rules. Everyone reads; only the commissioner
    // writes. Results live on the tournament document, so this covers them.
    match /tournaments/{doc}     { allow read: if signedIn(); allow write: if isCommish(); }
    match /league_settings/{doc} { allow read: if signedIn(); allow write: if isCommish(); }

    // ── Push tokens ─────────────────────────────────────────────────────────
    // Doc ID is the FCM token itself. A device registers and unregisters its
    // own token; the browser never lists the collection — api/push.js does
    // that with admin credentials, which bypass these rules.
    match /pushTokens/{token} {
      allow read: if isCommish();
      allow create, update: if signedIn() && ownsTeam(request.resource.data.get('teamId', null));
      allow delete:         if signedIn() && ownsTeam(resource.data.get('teamId', null));
    }

    // ── Anything not named above ────────────────────────────────────────────
    // Default deny. A new collection is invisible and unwritable until someone
    // adds a rule for it on purpose.
    //
    // This is the clause that made the earlier draft dangerous: team_claims was
    // not listed, so this silently denied the entire sign-in flow. When adding
    // a collection to the app, add it here in the same change.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
